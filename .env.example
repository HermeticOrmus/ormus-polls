# Server
PORT=8096
DB_PATH=./data/polls.db

# Firebase Auth — create a free project at https://console.firebase.google.com
# then enable Google Sign-In and copy these values from Project Settings → General → Web app
FIREBASE_PROJECT_ID=your-firebase-project
FIREBASE_AUTH_DOMAIN=your-firebase-project.firebaseapp.com
FIREBASE_API_KEY=your-firebase-api-key

# Comma-separated list of admin emails (full access to /:slug/results)
ADMIN_EMAILS=you@example.com,colleague@example.com
